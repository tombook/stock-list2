# Copy to .env and adjust. Defaults point at the existing stock-list Postgres (host 5433)
# and Redis (6379) containers, which stock-list2 reuses.
APP_HOST=0.0.0.0
APP_PORT=8900
LOG_LEVEL=INFO

# PostgreSQL — the stock-list2 database lives in the shared stock-list-pg container.
# Host 5432 is occupied by another project, so the container is mapped to 5433.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stocklist2
DB_USER=postgres
DB_PASS=tombook920!@#

# Redis (optional; used for caching/health). Soft dependency — app runs without it.
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated origins. Empty = allow all (dev).
CORS_ORIGINS=
